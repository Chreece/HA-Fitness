      "roles": {
        "bluetooth": {
          "extractors": [
            {
              "source": "ant_device_number",
              "target": "ant_device_number:heart_rate",
              "transform": "integer"
            },
            {
              "source": "antplus_device_number",
              "target": "ant_device_number:heart_rate",
              "transform": "integer"
            },
            {
              "source": "ant_id",
