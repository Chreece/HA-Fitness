              "transform": "integer"
            },
            {
              "source": "antplus_id",
              "target": "ant_device_number:heart_rate",
              "transform": "integer"
            },
            {
              "source": "advertised_name",
              "target": "ant_device_number:heart_rate",
              "regex": "\\bANT\\+?\\s*(?:ID)?\\s*[-:#]?\\s*(\\d{1,10})\\b",
              "group": 1,
              "transform": "integer"
            }
          ],
          "manufacturer_data_id": 135
        },
        "antplus": {
          "manufacturer_id": 1,
          "profiles": [
            120
          ],
          "extractors": [
            {
              "source": "device_number",
              "target": "ant_device_number:heart_rate",
              "transform": "integer"
            }
          ]
        }
      }
    }
